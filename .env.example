ADMIN_USERNAME=admin-operator
# Use a unique secret with at least 12 chars and 3 character classes.
ADMIN_PASSWORD=replace-with-a-unique-strong-secret
# Optional alternative to ADMIN_PASSWORD: scrypt hash generated by the application hash utility.
# ADMIN_PASSWORD_HASH=$scrypt$v=1$N=16384,r=8,p=1,keylen=64$replace-salt$replace-hash
ADMIN_DOMAIN=127.0.0.1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_ADMIN_NAME=admin
APP_SECTION_DASHBOARD_ENABLED=true
APP_SECTION_PROVEEDORES_ENABLED=true
APP_SECTION_TIPOS_ENABLED=true
APP_SECTION_PRODUCTOS_ENABLED=true
APP_SECTION_METODOS_PAGO_ENABLED=true
APP_SECTION_CAJAS_ENABLED=true
APP_SECTION_VENTAS_ENABLED=true
APP_SECTION_MOSTRADOR_ENABLED=true
APP_SECTION_STOCK_ENABLED=true
APP_SECTION_USUARIOS_ENABLED=true
